{
  "name": "kala-layout-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "npm run sync && astro dev --host 127.0.0.1",
    "build": "npm run sync && astro build && node scripts/validate-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "astro": "7.3.8"
  }
}
