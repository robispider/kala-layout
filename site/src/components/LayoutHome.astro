---
import board from '../generated/board.json';
import { Content as AdditionalChecksEn } from '../generated/additional-checks-en.md';
import { Content as AdditionalChecksBn } from '../generated/additional-checks-bn.md';
import { Content as SearchStoryEn } from '../generated/search-story-en.md';
import { Content as SearchStoryBn } from '../generated/search-story-bn.md';
const { locale = 'en' } = Astro.props;
const bn = locale === 'bn';
const AdditionalChecks = bn ? AdditionalChecksBn : AdditionalChecksEn;
const SearchStory = bn ? SearchStoryBn : SearchStoryEn;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (route: string) => `${base}/${locale}/${route}/`;
const appHref = (route: string = '') => `https://robispider.github.io/kala-releases/${locale}/${route ? route + '/' : ''}`;
const digits = (s) => bn ? String(s).replace(/[0-9]/g, d => '০১২৩৪৫৬৭৮৯'[Number(d)]) : String(s);
const fmt = (n) => digits(n.toFixed(4));
const entries = board.public.entries;
const heads = bn ? ['উইকিপিডিয়া', 'সংবাদপত্র', 'BARD সংবাদ'] : ['Wikipedia', 'Newspaper', 'BARD news'];
const columns = ['wikipedia', 'newspaper', 'unseenNews'];
const nameOf = e => e.kind === 'shared-style' && bn ? `${board.public.public_name_bn} · ${e.style === 'A' ? 'গতি' : 'ঝড়'} স্টাইল` : e.name;
const cards = [
 { route: 'layouts', title: bn ? 'একটি ম্যাপ, দুটি নিয়ম' : 'One map, two entry recipes', body: bn ? 'একই কীতে একই প্রতীক। গতিতে একুশে/অভ্রের আধুনিক ফিক্সড-লেআউট ধারা, ঝড়ে নির্ধারিত প্রসঙ্গ/পুনরাবৃত্তির নিয়ম।' : 'The same symbols stay on the same keys. Goti follows the modern Ekushey/Avro fixed-layout tradition; Jhor uses the specified context/repeat rule.' },
 { route: 'reproduce', title: bn ? 'নিজে ফল যাচাই করুন' : 'Rebuild the evidence', body: bn ? 'সংরক্ষিত গণনা থেকে স্কোরার, রিপোর্ট ও এক্সপোর্ট তৈরি করুন। মূল আলাদা সার্চও সংরক্ষিত।' : 'Build the scorer, report and exports from saved counts. The original separate searches remain reproducible.' },
 { route: 'challenge', title: bn ? 'ভালো অভিন্ন ম্যাপ খুঁজুন' : 'Challenge the shared arrangement', body: bn ? 'একটি ম্যাপ জমা দিন; দুই স্টাইলেই যোগ্যতা ও আলাদা Balance স্কোর যাচাই হবে।' : 'Submit one map. Both styles must qualify, with separate Balance scores and no combined R.' },
];
---
<div class="kala-home">
 <section class="home-section search-story" aria-label={bn ? 'সার্চ থেকে কালা লেআউট' : 'How the search found Kala Layout'}><SearchStory /></section>
 <section class="home-section" aria-labelledby="result-title">
  <div class="section-heading"><p class="eyebrow">{bn ? 'ফল / কালা লেআউট' : 'RESULTS / KALA LAYOUT'}</p><h2 id="result-title">{bn ? 'অভিন্ন বিন্যাস। দুই স্টাইলের ফল।' : 'A shared arrangement, evaluated in both styles.'}</h2><p>{bn ? 'প্রতি টেক্সট এককে মডেলের পরিশ্রম (J1); কম ভালো। মাপা টাইপিং-গতি নয়।' : 'Modeled effort per text unit (J1); lower is better. This is not measured typing speed.'}</p></div>
  <div class="board-wrap"><table class="board"><thead><tr><th>#</th><th>{bn ? 'কনফিগারেশন' : 'Configuration'}</th>{heads.map(h => <th>{h}</th>)}<th>{bn ? 'গড়' : 'Mean'}</th></tr></thead><tbody>{entries.map((e, i) => <tr class={e.kind === 'shared-style' ? 'ours' : ''}><td>{digits(i+1)}</td><td>{nameOf(e)}</td>{columns.map(c => <td>{fmt(e.j1[c])}</td>)}<td>{fmt(e.average)}</td></tr>)}</tbody></table></div>
  <p class="small-note">{bn ? 'সাতটি বাস্তব বিন্যাস, আটটি কনফিগারেশন: একই কালা লেআউটের দুই স্টাইল ও ছয়টি ফিক্সড বেসলাইন। পরিচিত আলাদা রাখা উৎসের সমান গড়। কালা লেআউট মডেল-অপটিমাল আঙুল-বিন্যাসে; বেসলাইনে আগের অনুকূল স্কোর রাখা হয়েছে। ফোনেটিক তুলনা নেই। এই J1 সারণি চ্যালেঞ্জের ক্রম নয়।' : 'Seven physical arrangements, eight configurations: two styles on Kala Layout and six fixed baselines. Equal means of known held-out sources. Kala Layout uses model-optimal fingering; baselines retain favorable recorded original scores. No phonetic comparisons. This J1 table is not the challenge ranking.'} <a href={href('leaderboard')}>{bn ? 'পূর্ণ তুলনা ও চ্যালেঞ্জ' : 'Comparisons and shared challenge'} →</a></p>
 </section>
 <section class="home-section additional-checks" aria-label={bn ? 'অভিন্ন বিন্যাসের খরচ' : 'The costs of sharing'}><AdditionalChecks /></section>
 <section class="home-section" aria-labelledby="do-title"><div class="section-heading"><p class="eyebrow">{bn ? 'বুঝুন / যাচাই করুন / চ্যালেঞ্জ করুন' : 'UNDERSTAND / VERIFY / CHALLENGE'}</p><h2 id="do-title">{bn ? 'ম্যাপ থেকে প্রমাণে।' : 'From the map to the evidence.'}</h2></div><div class="guide-grid">{cards.map((c,i) => <a class="guide-card" href={href(c.route)}><span class="guide-number">{digits(i+1)}</span><h3>{c.title}</h3><p>{c.body}</p><span class="text-link">{bn ? 'আরও পড়ুন' : 'Read more'} →</span></a>)}</div></section>
 <section class="home-section use-section" aria-labelledby="use-title"><div><p class="eyebrow">{bn ? 'গবেষণা / অ্যাপের প্রাপ্যতা' : 'RESEARCH / APP AVAILABILITY'}</p><h2 id="use-title">{bn ? 'বর্তমান পছন্দ, নিশ্চিত ইনস্টল নয়।' : 'A research choice, with availability made clear.'}</h2><p class="section-body">{bn ? 'কালা লেআউট গবেষণার এক্সপোর্ট। এই ওয়েবসাইট আপডেটে কালা অ্যাপ বা Learn অনুশীলন বদলায় না। পুরোনো ইনস্টলেশনে আগের ম্যাপ থাকতে পারে; ঝড়ে সামঞ্জস্যপূর্ণ প্রসঙ্গভিত্তিক ইঞ্জিন দরকার। ব্যবহারের আগে ম্যাপ ও সংস্করণ মিলিয়ে নিন।' : 'Kala Layout is available as research exports. This website update does not change Kala or its Learn exercises. Existing installations may use the original maps; Jhor needs a compatible context-vowel engine. Check the map and version before use.'}</p></div><div class="use-links"><a href={href('layouts')}>{bn ? 'ম্যাপ, নিয়ম ও গবেষণার এক্সপোর্ট' : 'Map, style rules and research exports'} →</a><a href={appHref('release-status')}>{bn ? 'কালার রিলিজের অবস্থা' : 'Kala release status'} ↗</a><a href={appHref('guide/installation')}>{bn ? 'অ্যাপ ইনস্টলেশনের নির্দেশনা' : 'App installation guide'} ↗</a><a href={appHref('guide/learning')}>{bn ? 'অ্যাপে শেখার নির্দেশনা' : 'App learning guide'} ↗</a></div></section>
 <section class="home-section"><h2>{bn ? 'মূল গবেষণা সংরক্ষিত আছে।' : 'The original research remains available.'}</h2><p>{bn ? 'মূল পরিশ্রমের মডেল, আলাদা বিন্যাসের সার্চ ও সীমা ইতিহাসে অক্ষত। নতুন অভিন্ন সিদ্ধান্তের কারণ, শিথিল সীমা, চলাচলের খরচ ও অসম্পূর্ণ প্রমাণ আলাদাভাবে নথিভুক্ত।' : 'The original effort model, separate searches and scoped bounds remain intact. The new shared decision records its rationale, relaxed limits, movement costs and evidence gaps separately.'}</p><div class="inline-links"><a href={href('how')}>{bn ? 'গবেষণার ইতিহাস' : 'Research history'} →</a><a href={href('shared')}>{bn ? 'পরিবর্তনের যুক্তি' : 'Transition rationale'} →</a><a href={href('data')}>{bn ? 'ডেটাসেট' : 'Datasets'} →</a></div></section>
</div>
<style>
  .kala-home { --home-border: var(--sl-color-gray-5); line-height: 1.7; }
  .kala-home :is(h2,h3,p) { margin: 0; }
  .home-section { padding-block: 3.2rem; border-bottom: 1px solid var(--home-border); }
  .eyebrow { font-size: .72rem; letter-spacing: .1em; color: var(--sl-color-text-accent); font-weight: 750; margin-bottom: .65rem !important; }
  h2 { font-size: clamp(1.65rem,3vw,2.2rem); line-height: 1.3; letter-spacing: -.035em; color: var(--sl-color-white); }
  h3 { font-size: 1.15rem; line-height: 1.45; }
  .section-heading > p:last-child, .section-body { margin-top: .8rem !important; color: var(--sl-color-gray-2); }
  .section-body { margin-bottom: 1.3rem !important; }
  .board-wrap { margin-top: 1.5rem; overflow-x: auto; }
  .board { display: table; width: 100%; max-width: none; overflow: visible; border-collapse: collapse; font-size: .92rem; font-variant-numeric: tabular-nums; }
  .board th, .board td { padding: .55rem .8rem; border-bottom: 1px solid var(--home-border); text-align: right; white-space: nowrap; }
  .board th:nth-child(-n+2), .board td:nth-child(-n+2) { text-align: left; }
  .board th { font-size: .75rem; color: var(--sl-color-gray-2); font-weight: 650; }
  .board tr.ours td { font-weight: 700; color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  .search-story :global(h2), .additional-checks :global(h2) { font-size: clamp(1.65rem,3vw,2.2rem); line-height: 1.3; letter-spacing: -.035em; color: var(--sl-color-white); }
  .additional-checks :global(p) { margin-top: 1rem; color: var(--sl-color-gray-2); }
  .additional-checks :global(table) { display: block; width: max-content; max-width: 100%; overflow-x: auto; margin-block: 1.5rem; border-collapse: collapse; font-size: .92rem; font-variant-numeric: tabular-nums; }
  .additional-checks :global(th), .additional-checks :global(td) { padding: .65rem .8rem; border-bottom: 1px solid var(--home-border); text-align: right; white-space: nowrap; }
  .additional-checks :global(th:first-child), .additional-checks :global(td:first-child) { text-align: left; white-space: normal; min-width: 12rem; max-width: 24rem; }
  .additional-checks :global(th) { font-size: .8rem; font-weight: 650; color: var(--sl-color-gray-2); }
  .guide-grid, .layout-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; margin-top: 1.7rem; }
  .guide-grid > *, .layout-grid > * { margin-top: 0 !important; }
  .layout-card, .guide-card { border: 1px solid var(--home-border); border-radius: 4px; padding: 1.3rem; display: flex; flex-direction: column; min-width: 0; }
  .layout-card { border: 0; border-top: 1px solid var(--home-border); border-radius: 0; padding-inline: 0; }
  .use-section { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; align-items: center; padding: 2rem; margin-top: 2rem; border: 1px solid var(--home-border); border-left: 3px solid var(--sl-color-accent); background: var(--sl-color-gray-6); }
  .use-section h2 { font-size: 1.8rem; }
  .use-section .section-body { font-size: .9rem; margin-bottom: 0 !important; }
  .use-links { display: grid; }
  .use-links a { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--home-border); font-size: .85rem; font-weight: 600; text-decoration: none; }
  .use-links a:hover { text-decoration: underline; }
  .guide-number { font-size: .75rem; font-weight: 750; color: var(--sl-color-text-accent); margin-bottom: 1rem; }
  .layout-card p, .guide-card p { margin-top: .7rem; font-size: .9rem; color: var(--sl-color-gray-2); flex: 1; }
  .text-link { font-size: .86rem; font-weight: 650; color: var(--sl-color-text-accent); }
  .guide-card .text-link { margin-top: 1.3rem; }
  .small-note { font-size: .8rem; color: var(--sl-color-gray-2); margin-top: 1rem !important; }
  .layout-card h3 { margin-top: .6rem; }
  .layout-kind { font-size: .72rem; color: var(--sl-color-gray-2); }
  .guide-card { text-decoration: none; color: var(--sl-color-text); transition: border-color .15s, background .15s; }
  .guide-card:hover { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .research-section { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; }
  .research-facts { border: 1px solid var(--home-border); border-radius: 4px; padding: 1.5rem; background: var(--sl-color-gray-6); }
  .research-facts > div + div { margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--home-border); }
  .research-facts strong { display: block; font-size: clamp(1.6rem,3vw,2.2rem); letter-spacing: -.04em; color: var(--sl-color-text-accent); }
  .research-facts span { display: block; font-size: .83rem; color: var(--sl-color-gray-2); }
  .research-note { grid-column: 1 / -1; padding: 1rem; border-left: 3px solid var(--sl-color-accent); border-radius: 0 8px 8px 0; background: var(--sl-color-gray-6); color: var(--sl-color-gray-2); font-size: .82rem; }
  .inline-links { display: flex; flex-wrap: wrap; gap: .7rem 1.5rem; font-size: .9rem; font-weight: 650; }
  .free-section { padding: 2rem; margin-top: 2rem; border: 1px solid var(--home-border); border-radius: 4px; background: var(--sl-color-gray-6); }
  :global(html[lang='bn']) .additional-checks :global(h2) { letter-spacing: 0; line-height: 1.5; }
  :global(html[lang='bn']) :is(h2,h3) { letter-spacing: 0; line-height: 1.5; }
  @media (max-width: 55rem) { .guide-grid, .layout-grid, .research-section, .use-section { grid-template-columns: 1fr; } }
  @media (max-width: 45rem) { .home-section { padding-block: 2rem; } .free-section, .use-section { padding: 1.3rem; } }
  @media (prefers-reduced-motion: reduce) { .guide-card { transition: none; } }
</style>
