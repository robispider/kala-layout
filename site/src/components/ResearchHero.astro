---
import board from '../generated/board.json';
const bn = Astro.url.pathname.includes('/bn/');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (route: string) => `${base}/${bn ? 'bn' : 'en'}/${route}/`;
---
<section class="research-hero" aria-labelledby="_top">
  <div class="journal-line"><span>{bn ? 'বাংলা কিবোর্ড / প্রকাশিত গবেষণা' : 'BANGLA KEYBOARD / PUBLISHED RESEARCH'}</span><a href={`${base}/${bn ? 'en' : 'bn'}/`}>{bn ? 'English' : 'বাংলা'}</a></div>
  <div class="hero-grid"><div class="hero-copy">
    <p class="hero-label">{bn ? 'Frozen mixed-training J1 / best found' : 'FROZEN MIXED-TRAINING J1 / BEST FOUND'}</p>
    <h1 id="_top" data-page-title>{bn ? 'কালা গতি ও কালা ঝড়' : 'Kala Goti and Kala Jhor'}</h1>
    <p class="hero-tagline">{bn ? 'দুটি ম্যাপ। নিজস্ব টাইপিং নিয়ম।' : 'Two maps. Native typing rules.'}</p>
    <p class="hero-intro">{bn ? 'আঙুলের পরিশ্রমের নির্দিষ্ট মডেলে সার্চ থেকে নির্বাচিত আলাদা লেআউট। গতির নতুন ৮০০ কোটি প্রস্তাব ও লোকাল সার্চে কোনো উন্নতি পাওয়া যায়নি; ৮,০০০ শুরুর ৫১৪টি একই প্রকাশিত ম্যাপে পৌঁছেছে। ঝড়ের আগের প্রমাণ বহাল আছে।' : 'Separate layouts selected by search under an explicit finger-effort model. A new Goti run found no improvement in eight billion proposals plus local search; 514 of 8,000 starts returned its published map. Jhor retains its original evidence.'}</p>
    <div class="hero-actions"><a class="primary-action" href={href('layouts')}>{bn ? 'ম্যাপ ও নিয়ম' : 'Maps and rules'} →</a><a href={href('goti-evidence')}>{bn ? 'গতির প্রমাণ' : 'Goti evidence'} →</a><a href={href('publication')}>{bn ? 'নির্বাচনের মানদণ্ড' : 'Selection criterion'} →</a></div>
    <p>{bn ? 'মডেলের স্কোর; মানুষের টাইপিং গতি বা স্বাচ্ছন্দ্যের পরিমাপ নয়। Global optimum প্রমাণিত নয়।' : 'Modeled effort, with no measurement of human speed or comfort and no proof of global optimality.'}</p>
  </div></div>
</section>
<style>
  .research-hero { padding-block: 1.5rem 0; }
  .journal-line { display:flex; justify-content:space-between; gap:1rem; padding-bottom:1rem; border-bottom:1px solid var(--sl-color-gray-5); font-size:.68rem; font-weight:700; letter-spacing:.09em; color:var(--sl-color-gray-2); }
  .hero-grid { display:grid; grid-template-columns:1.1fr 1fr; align-items:center; gap:3rem; padding-block:3rem; }
  .hero-label { margin:0 0 .8rem; color:var(--sl-color-text-accent); font-size:.7rem; font-weight:750; letter-spacing:.1em; }
  h1 { margin:0; max-width:12ch; font-size:clamp(2.8rem,5vw,4.5rem); font-weight:650; letter-spacing:-.055em; line-height:1.08; color:var(--sl-color-white); }
  .hero-tagline { margin:.8rem 0 0; font-size:1.25rem; font-weight:600; line-height:1.5; color:var(--sl-color-white); }
  .hero-intro { max-width:43ch; margin-block:1.4rem; font-size:1.08rem; line-height:1.75; color:var(--sl-color-gray-2); }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1rem 1.4rem; }
  .hero-actions a { font-size:.86rem; font-weight:650; text-decoration:none; }
  .research-hero a { color:var(--sl-color-text-accent); }
  .hero-actions .primary-action { color:var(--sl-color-black); }
  .primary-action { display:inline-flex; align-items:center; gap:1.3rem; padding:.85rem 1.1rem; background:var(--sl-color-text-accent); color:var(--sl-color-black); border-radius:4px; }
  .hero-actions a:hover, .research-nav a:hover { text-decoration:underline; text-underline-offset:4px; }
  .hero-scope { margin:1.3rem 0 0; max-width:48ch; color:var(--sl-color-gray-2); font-size:.76rem; line-height:1.7; }
  .evidence-panel { padding:1.6rem; border:1px solid var(--sl-color-gray-5); border-top:3px solid var(--sl-color-accent); border-radius:6px; background:var(--sl-color-gray-6); }
  .panel-head { display:flex; align-items:center; gap:1rem; justify-content:space-between; }
  h2 { margin:0; font-size:1.35rem; line-height:1.4; letter-spacing:-.025em; max-width:18ch; color:var(--sl-color-white); }
  .panel-caption { font-size:.72rem; color:var(--sl-color-gray-2); margin:.7rem 0 0; }
  .mascot-frame { flex-shrink:0; display:flex; align-items:center; justify-content:center; width:5.5rem; height:8.5rem; padding:.5rem; background:#e5edda; border-radius:4px; }
  .mascot-frame img { width:auto; height:100%; max-width:100%; object-fit:contain; }
  .effort-chart { margin-top:1.5rem; display:grid; gap:1rem; }
  .chart-label { display:flex; justify-content:space-between; gap:1rem; font-size:.8rem; margin-bottom:.4rem; }
  .chart-label strong { font-variant-numeric:tabular-nums; font-weight:600; }
  .bar-track { height:6px; background:var(--sl-color-gray-5); }
  .bar-track span { display:block; height:100%; background:var(--sl-color-gray-3); }
  .kala-row .bar-track span { background:var(--sl-color-accent); }
  .kala-row .chart-label { color:var(--sl-color-text-accent); }
  .panel-source { display:flex; justify-content:space-between; margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--sl-color-gray-5); font-size:.75rem; font-weight:600; text-decoration:none; }
  .research-nav { display:flex; flex-wrap:wrap; gap:.75rem 1.8rem; border-block:1px solid var(--sl-color-gray-5); padding:1rem 0; font-size:.8rem; font-weight:600; }
  .research-nav a:last-child { margin-left:auto; }
  :global(html[lang='bn']) h1 { max-width:14ch; line-height:1.35; letter-spacing:0; }
  :global(html[lang='bn']) h2 { letter-spacing:0; }
  @media(max-width:60rem) { .hero-grid { gap:1.8rem; } }
  @media(max-width:48rem) { .hero-grid { grid-template-columns:1fr; padding-block:2rem; } h1 { max-width:15ch; } .journal-line { font-size:.6rem; } .journal-line span:last-child { display:none; } .research-nav a:last-child { margin-left:0; } .evidence-panel { padding:1.2rem; } }
</style>
