  "minimum_corrections": 20,
  "folds": 5,
  "seed": 20261027,
  "ridge_penalty": 1.0,
  "bootstrap_repetitions": 500,
  "cost_model_bootstrap_repetitions": 50,
  "minimum_transition_contributors": 3,
  "threshold_interpretation": "Engineering floors for experimental execution; not power or layout-comparison sample-size justification.",
  "required_scenarios": [
    "ordinary_check", "pause_focus", "fast_corrections_held_keys", "timed_enter_boundary",
